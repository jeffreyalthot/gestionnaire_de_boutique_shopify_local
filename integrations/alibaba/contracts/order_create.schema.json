{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elit21.com/contracts/alibaba/order_create.schema.json",
  "title": "Order Create",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "supplierId",
    "items",
    "shippingAddress"
  ],
  "properties": {
    "supplierId": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1
    },
    "shippingAddress": {
      "type": "object"
    }
  }
}
