# Environment example additions for AliExpress

# Existing .env.example kept; add AliExpress entries below.

SUPPLIER_PROVIDER=alibaba  # or aliexpress

# AliExpress Open Platform (REST v2)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_REFRESH_TOKEN=
ALIEXPRESS_BASE_URL=https://api-sg.aliexpress.com/rest
ALIEXPRESS_OAUTH_AUTHORIZE_URL=https://oauth.aliexpress.com/authorize
ALIEXPRESS_OAUTH_TOKEN_URL=https://oauth.aliexpress.com/token/create
ALIEXPRESS_OAUTH_REFRESH_URL=https://oauth.aliexpress.com/token/refresh
