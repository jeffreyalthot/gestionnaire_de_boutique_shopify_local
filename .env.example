# APPLICATION
APP_ENV=development
APP_NAME=shopify_alibaba_ai_orchestrator
APP_HOST=127.0.0.1
APP_PORT=8080
APP_TIMEZONE=America/Montreal
APP_CURRENCY=CAD
APP_LOG_LEVEL=INFO
APP_DRY_RUN=true
APP_DATABASE_PATH=data/database/orchestrator.db
APP_PUBLIC_BASE_URL=http://127.0.0.1:8080

# SHOPIFY
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CALLBACK_BASE_URL=
SHOPIFY_ENABLE_REST_COMPATIBILITY=false
SHOPIFY_REQUEST_TIMEOUT_SECONDS=30
SHOPIFY_MAX_RETRIES=5

# ALIBABA
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=
ALIBABA_REFRESH_TOKEN=
ALIBABA_CALLBACK_URL=
ALIBABA_GATEWAY_URL=https://eco.taobao.com/router/rest
ALIBABA_OAUTH_URL=https://oauth.alibaba.com/authorize
ALIBABA_SIGN_METHOD=hmac
ALIBABA_PAYMENT_MODE=authorized_api
ALIBABA_PAYMENT_TOKEN_REFERENCE=
ALIBABA_REQUIRE_MANUAL_PAYMENT_APPROVAL=true
ALIBABA_REQUEST_TIMEOUT_SECONDS=30
ALIBABA_MAX_RETRIES=5

# PRICING
PRICING_MODE=gross_margin
TARGET_GROSS_MARGIN_PERCENT=50
MINIMUM_GROSS_MARGIN_PERCENT=40
SHIPPING_PROFIT_PERCENT=0
PRICE_ROUNDING_MODE=psychological
PRICE_ROUNDING_ENDING=0.99
PLATFORM_FEE_PERCENT=3.0
CURRENCY_BUFFER_PERCENT=2.0
REFUND_RESERVE_PERCENT=2.0
DUTY_TAX_BUFFER_PERCENT=5.0

# PROCUREMENT
ALIBABA_BATCH_THRESHOLD_CAD=500.00
ALIBABA_BATCH_MAX_AGE_MINUTES=240
ALIBABA_BATCH_MAX_ORDERS=100
ALIBABA_BATCH_MAX_SUPPLIERS=20
ALIBABA_BATCH_ALLOW_PARTIAL_SUBMISSION=false
ALIBABA_RECHECK_STOCK_BEFORE_PAYMENT=true
ALIBABA_RECHECK_PRICE_BEFORE_PAYMENT=true
ALIBABA_RECHECK_FREIGHT_BEFORE_PAYMENT=true

# INVENTORY
INVENTORY_SYNC_INTERVAL_SECONDS=60
INVENTORY_LOW_STOCK_THRESHOLD=5
INVENTORY_SAFETY_STOCK_QUANTITY=2
INVENTORY_UNPUBLISH_WHEN_OUT_OF_STOCK=true

# RUNTIME
DASHBOARD_REFRESH_SECONDS=5
RUNTIME_PROFILE=lite_2gb
RUNTIME_MAX_RSS_MB=850
RUNTIME_MAX_CPU_PERCENT=75
RUNTIME_MAX_PENDING_TASKS=5000
RUNTIME_MAX_HEAVY_OPERATIONS_PER_CYCLE=1
RUNTIME_MEDIA_CACHE_MB=256
RUNTIME_CYCLE_INTERVAL_SECONDS=60
AUTOMATION_ENABLED=true
AUTOMATION_FINANCIAL_LIMIT_CAD=1000
AUTOMATION_DEFAULT_MODE=dry_run
SHOPIFY_RECONCILIATION_INTERVAL_SECONDS=300
ALIBABA_RECONCILIATION_INTERVAL_SECONDS=300
PRODUCT_DISCOVERY_INTERVAL_SECONDS=1800
PRODUCT_DISCOVERY_KEYWORDS=home organization,pet accessories,desk accessories
PRODUCT_DISCOVERY_PAGE_SIZE=20
PRODUCT_DISCOVERY_MAX_PAGES=3
PRODUCT_DISCOVERY_MAX_CANDIDATES=100
PRODUCT_MINIMUM_SCORE=0.68
SUPPLIER_MINIMUM_SCORE=0.65
ORDER_RISK_HOLD_THRESHOLD=0.50
MEDIA_MAX_DOWNLOAD_BYTES=12582912
MEDIA_MINIMUM_DIMENSION=400
MEDIA_MAXIMUM_DIMENSION=10000
MEDIA_ALLOWED_HOSTS=
CUSTOMER_SERVICE_DEFAULT_SLA_HOURS=24
PRICE_SYNC_INTERVAL_SECONDS=900
TRACKING_SYNC_INTERVAL_SECONDS=300
DATABASE_BACKUP_INTERVAL_SECONDS=21600
WORKER_POLL_INTERVAL_SECONDS=1
MAX_CONCURRENT_HTTP_REQUESTS=2

# AI
AI_ENABLED=false
AI_PROFILE=strict_750mb
AI_MAX_RAM_MB=750
AI_MAX_CPU_PERCENT=65
AI_WORKER_THREADS=1
AI_ONLINE_LEARNING=false
AI_MICRO_LLM_ENABLED=false
AI_MICRO_LLM_MODEL_PATH=
AI_MICRO_LLM_CONTEXT_SIZE=256
AI_MINIMUM_AUTONOMOUS_CONFIDENCE=0.92

# SECURITY
SECRET_STORAGE_PROVIDER=windows_dpapi
DATABASE_ENCRYPT_PII=true
AUDIT_LOG_ENABLED=true
CUSTOMER_ADDRESS_RETENTION_DAYS=90
PAYMENT_DATA_STORAGE_FORBIDDEN=true
MASTER_ENCRYPTION_KEY=
